# Normalize line endings so shell scripts, .env files and seeds never pick up
# CRLF from a Windows checkout (start.sh must stay LF to run on the Mac).
* text=auto eol=lf

# Windows-native scripts are the one exception.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
